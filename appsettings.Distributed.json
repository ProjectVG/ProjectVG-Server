{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ProjectVG.Infrastructure.MessageBus": "Debug",
      "ProjectVG.Infrastructure.Session": "Debug",
      "ProjectVG.Application.Services.WebSocket": "Debug"
    }
  },
  "Distributed": {
    "Enabled": true,
    "ServerId": "${SERVER_ID}",
    "MessageBus": {
      "Type": "Redis",
      "Redis": {
        "ConnectionString": "${REDIS_CONNECTION_STRING}",
        "Database": 1,
        "ChannelPrefix": "projectvg:",
        "HeartbeatInterval": 30000,
        "CleanupInterval": 300000,
        "SessionTimeout": 3600000
      }
    },
    "Session": {
      "Type": "Redis",
      "Redis": {
        "ConnectionString": "${REDIS_CONNECTION_STRING}",
        "Database": 0,
        "KeyPrefix": "session:",
        "DefaultExpiration": 86400
      }
    },
    "LoadBalancing": {
      "Strategy": "RoundRobin",
      "HealthCheck": {
        "Enabled": true,
        "Interval": 30000,
        "Timeout": 5000,
        "UnhealthyThreshold": 3,
        "HealthyThreshold": 2
      }
    }
  },
  "Redis": {
    "ConnectionString": "${REDIS_CONNECTION_STRING}",
    "Options": {
      "AbortOnConnectFail": false,
      "ConnectRetry": 3,
      "ConnectTimeout": 5000,
      "SyncTimeout": 5000,
      "AsyncTimeout": 5000,
      "KeepAlive": 60,
      "ReconnectRetryPolicy": "ExponentialBackoff"
    }
  }
}