{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "${DB_CONNECTION_STRING}"
  },
  "LLM": {
    "BaseUrl": "${LLM_BASE_URL}"
  },
  "MEMORY": {
    "BaseUrl": "${MEMORY_BASE_URL}"
  },
  "TTSApiKey": "${TTS_API_KEY}",
  "Port": 7900,
  "JWT": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "AccessTokenLifetimeMinutes": "${JWT_ACCESS_TOKEN_LIFETIME_MINUTES}",
    "RefreshTokenLifetimeDays": "${JWT_REFRESH_TOKEN_LIFETIME_DAYS}"
  },
  "Redis": {
    "ConnectionString": "${REDIS_CONNECTION_STRING}"
  },
  "OAuth2": {
    "Enabled": "${OAUTH2_ENABLED}",
    "Providers": {
      "google": {
        "Enabled": "${GOOGLE_OAUTH_ENABLED}",
        "ClientId": "${GOOGLE_OAUTH_CLIENT_ID}",
        "ClientSecret": "${GOOGLE_OAUTH_CLIENT_SECRET}",
        "RedirectUri": "${GOOGLE_OAUTH_REDIRECT_URI}",
        "AutoCreateUser": "${GOOGLE_OAUTH_AUTO_CREATE_USER}",
        "DefaultRole": "${GOOGLE_OAUTH_DEFAULT_ROLE}",
        "Scopes": ["openid", "profile", "email"]
      }
    }
  }
} 